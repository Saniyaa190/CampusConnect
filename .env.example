# Flask Secret Key for Session Security & CSRF Protection
SECRET_KEY=change-this-to-a-secure-random-32-byte-key

# MySQL 8 Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusconnect
DB_USERNAME=root
DB_PASSWORD=your-local-mysql-password

# Development Fallback: Set to True to allow automatic SQLite fallback if MySQL is unreachable during local testing
ALLOW_SQLITE_FALLBACK=True

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1
