# Flask Secret Key for Session Security & CSRF Protection
SECRET_KEY=change-this-to-a-secure-random-32-byte-key

# Database Connection (Option A: Cloud Database URL - Recommended for Vercel, Railway, Render, Supabase, TiDB)
# DATABASE_URL=mysql+pymysql://username:password@hostname:3306/campusconnect
# DATABASE_URL=postgresql://username:password@hostname:5432/campusconnect

# Database Connection (Option B: Local MySQL 8 Server)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusconnect
DB_USERNAME=root
DB_PASSWORD=your-local-mysql-password

# Development Fallback: Set to True to allow automatic SQLite fallback if MySQL is unreachable during local testing/demo
ALLOW_SQLITE_FALLBACK=True

# Flask Environment & Server
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1
